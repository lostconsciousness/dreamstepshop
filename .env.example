# Optional. If unset, the app uses the default public API URL in src/api.ts (ngrok).
# VITE_API_URL=https://your-subdomain.ngrok-free.app
# VITE_API_URL=http://127.0.0.1:8000

# CryptoCloud (https://docs.cryptocloud.plus/ru) — invoice API from the browser.
# Keys from the project dashboard: API key + Shop ID.
# VITE_CRYPTOCLOUD_API_KEY=
# VITE_CRYPTOCLOUD_SHOP_ID=

# URLs in CryptoCloud project settings (see src/cryptocloudUrls.ts):
# Success:  https://dreamstepshop.general2286.workers.dev/payment-success
# Failed:   https://dreamstepshop.general2286.workers.dev/payment-failed
# Callback: https://dreamstepshop.general2286.workers.dev/callback  (server POSTBACK, not this SPA)
